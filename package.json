{
  "name": "water-station",
  "version": "1.0.0",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "server": "nodemon backend/server.js",
    "sync": "browser-sync start --proxy localhost:3000 --files frontend/**/* --port 3001 --no-open",
    "dev": "concurrently \"npm run server\" \"npm run sync\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "serialport": "^12.0.0",
    "socket.io": "^4.7.4"
  },
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.14",
    "sqlite3": "^6.0.1"
  }
}
